#!/usr/bin/env bash

# llm-stun-granade: Gibberify clipboard text with zero-width Unicode characters

# Zero-width Unicode characters
EMPTY_CHARS=(
    $'\u200B'  # ZERO WIDTH SPACE
    $'\u200C'  # ZERO WIDTH NON-JOINER
    $'\u200D'  # ZERO WIDTH JOINER
    $'\u2060'  # WORD JOINER
    $'\u2061'  # FUNCTION APPLICATION
    $'\u2062'  # INVISIBLE TIMES
    $'\u2063'  # INVISIBLE SEPARATOR
    $'\u2064'  # INVISIBLE PLUS
    $'\uFEFF'  # ZERO WIDTH NO-BREAK SPACE (BOM)
)

# Get clipboard content
if command -v xclip &> /dev/null; then
    CLIPBOARD_CONTENT=$(xclip -selection clipboard -o)
elif command -v xsel &> /dev/null; then
    CLIPBOARD_CONTENT=$(xsel --clipboard --output)
elif command -v wl-paste &> /dev/null; then
    CLIPBOARD_CONTENT=$(wl-paste)
else
    echo "Error: No clipboard tool found (xclip, xsel, or wl-paste required)" >&2
    exit 1
fi

# Check if clipboard is empty
if [ -z "$CLIPBOARD_CONTENT" ]; then
    echo "Error: Clipboard is empty" >&2
    exit 1
fi

# Gibberify the text
RESULT=""
TEXT_LENGTH=${#CLIPBOARD_CONTENT}

for (( i=0; i<TEXT_LENGTH; i++ )); do
    # Add the current character
    RESULT+="${CLIPBOARD_CONTENT:$i:1}"
    
    # Don't add empty characters after the last character
    if [ $i -lt $((TEXT_LENGTH - 1)) ]; then
        # Add 150-200 random empty characters
        NUM_EMPTY=$((150 + RANDOM % 51))
        
        for (( j=0; j<NUM_EMPTY; j++ )); do
            # Select a random empty character
            RANDOM_INDEX=$((RANDOM % ${#EMPTY_CHARS[@]}))
            RESULT+="${EMPTY_CHARS[$RANDOM_INDEX]}"
        done
    fi
done

# Copy the gibberified text back to clipboard
if command -v xclip &> /dev/null; then
    echo -n "$RESULT" | xclip -selection clipboard
elif command -v xsel &> /dev/null; then
    echo -n "$RESULT" | xsel --clipboard --input
elif command -v wl-copy &> /dev/null; then
    echo -n "$RESULT" | wl-copy
fi

# Print summary
echo "✓ Clipboard gibberified"
echo "Original length: ${#CLIPBOARD_CONTENT}"
echo "Gibberified length: ${#RESULT}"
